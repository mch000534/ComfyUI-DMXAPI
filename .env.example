# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file or real API keys.

# Generic fallback used by all DMXAPI nodes.
DMXAPI_KEY=sk-your-dmxapi-key

# Optional model-family-specific keys.
# Leave these blank if DMXAPI_KEY is sufficient.
OPENAI_API_KEY=
AGNES_API_KEY=
MINIMAX_API_KEY=
SEEDANCE_API_KEY=
ARK_API_KEY=
